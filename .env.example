# Database (Vercel Postgres / Neon)
POSTGRES_URL=postgres://...

# Auth
JWT_SECRET=your-secret-key-here

# AI (optional - falls back to static insights)
ANTHROPIC_API_KEY=sk-ant-...

# Cron protection
CRON_SECRET=your-cron-secret

# OpenAI (for OpenClaw bot)
OPENAI_API_KEY=sk-proj-...

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Vercel CD (GitHub Actions deploy)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Google Custom Search (busca de preços)
# 1. Google Cloud Console → Enable Custom Search API → gerar API key
# 2. https://programmablesearchengine.google.com → criar engine → pegar CX
# 3. Configurar engine para "Search the entire web"
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Mercado Livre API (requer OAuth2 app)
# https://developers.mercadolibre.com.br → criar app → obter token
ML_ACCESS_TOKEN=

# Bing Search (fallback busca de preços)
# Azure Portal → Create Bing Search v7 resource → copy key
BING_API_KEY=

# App URL (for family invites, notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3500
